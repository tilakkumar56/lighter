# Telegram Bot Configuration
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Lighter.xyz Configuration
# Get API key from https://app.lighter.xyz (Account Settings > API Keys)
LIGHTER_API_KEY=your_lighter_api_key_here

# Your wallet private key (for future on-chain trading integration)
LIGHTER_PRIVATE_KEY=your_wallet_private_key_here

# Network Configuration (mainnet or testnet)
LIGHTER_NETWORK=mainnet

# Allowed Telegram User IDs (comma-separated, for security)
# Get your ID from @userinfobot on Telegram
ALLOWED_USER_IDS=123456789
