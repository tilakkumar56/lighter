# Telegram Bot Configuration
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Lighter.xyz Perpetual Futures API Configuration
# Get these from https://app.lighter.xyz -> Settings -> API Keys

# Your API Key Index (3-254, indexes 0-2 are reserved)
LIGHTER_API_KEY_INDEX=3

# Your API Private Key (generated from Lighter)
LIGHTER_API_PRIVATE_KEY=your_api_private_key_here

# Your Account Index on Lighter (find via AccountApi or settings)
LIGHTER_ACCOUNT_INDEX=your_account_index_here

# Network: mainnet or testnet
LIGHTER_NETWORK=mainnet

# Allowed Telegram User IDs (comma-separated, for security)
# Get your ID from @userinfobot on Telegram
ALLOWED_USER_IDS=your_telegram_user_id
