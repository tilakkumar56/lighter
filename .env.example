# Telegram Bot Configuration
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Lighter.xyz Perpetual Futures API Configuration
# Get these from https://app.lighter.xyz -> Settings -> API Keys

# Your API Key Index (3-254, indexes 0-2 are reserved for desktop/mobile)
LIGHTER_API_KEY_INDEX=3

# Your API Private Key (generated from Lighter when creating API key)
LIGHTER_API_PRIVATE_KEY=your_api_private_key_here

# Your Account Index on Lighter
# ⚠️ IMPORTANT: This is NOT 0! You must find your actual account index!
#
# To find your account index, run:
#   python find_account_index.py YOUR_WALLET_ADDRESS
#
# Example:
#   python find_account_index.py 0x1234567890abcdef1234567890abcdef12345678
#
# Or find it on https://app.lighter.xyz -> Settings
LIGHTER_ACCOUNT_INDEX=YOUR_ACCOUNT_INDEX_HERE

# Network: mainnet or testnet
LIGHTER_NETWORK=mainnet

# Allowed Telegram User IDs (comma-separated, for security)
# Get your ID from @userinfobot on Telegram
ALLOWED_USER_IDS=your_telegram_user_id
